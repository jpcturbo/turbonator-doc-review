# --- Project-Specific Ignores ---
manifest.json
batches/
scratch/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# --- Node.js & npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm/
.yarn/cache/

# --- HTML5 & Frontend Web Cache ---
.cache/
.parcel-cache/
*.log
*.tmp
*.bak

# --- Gemini, AI & Editor Scratch Files ---
.gemini/
.idea/
.vscode/
*.swp
*~
*.sublime-workspace
*.sublime-project

# --- OS-Specific Junk ---
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
